standard	Testing	[test, staging]
standard	Production	[production]

# -------------------------------------------------------------- code references

query TTIT
SELECT name, type, branch_count, branches FROM launchdarkly.main.code_ref_repositories ORDER BY name;
----
api-server	gitlab	1	[master]
web-app	github	2	[main, feature/x]

query TTTITT
SELECT repository, branch, path, starting_line, project_key, flag_key FROM launchdarkly.main.code_references() ORDER BY ALL;
----
api-server	master	limits/rate.go	88	default	api-rate-limit
api-server	master	mobile/onboard.go	3	mobile	onboarding-v2
web-app	main	src/checkout/index.ts	5	default	new-checkout
web-app	main	src/theme.ts	12	default	dark-mode
web-app	main	src/theme.ts	40	default	dark-mode

query TTI
SELECT repository, path, starting_line FROM launchdarkly.main.code_references() WHERE flag_key = 'dark-mode' ORDER BY ALL;
----
web-app	src/theme.ts	12
web-app	src/theme.ts	40

query I
SELECT count(*) FROM read_json('{LAUNCHDARKLY_FIXTURE_URL}/__requests?path=/api/v2/code-refs/repositories') WHERE query LIKE '%"flagKey": "dark-mode"%';
----
1

# -------------------------------------------------------------------- audit_log

# What changed in production right before the incident: spec + after/before are pushed.
query TTTT
SELECT id, actor, resource_key, title FROM launchdarkly.main.audit_log() WHERE resource_kind = 'flag' AND environment_key = 'production' AND date BETWEEN TIMESTAMPTZ '2026-11-14 09:00:00+00' AND TIMESTAMPTZ '2026-11-14 12:00:00+00' ORDER BY date DESC;
----
al01	kat@example.com	api-rate-limit	Katherine Johnson changed the default variation of API rate limit
al02	grace@example.com	new-checkout	Grace Hopper updated the targeting rules of New checkout flow
al03	ada@example.com	dark-mode	Ada Lovelace turned on Dark mode

query I
SELECT count(*) FROM read_json('{LAUNCHDARKLY_FIXTURE_URL}/__requests?path=/api/v2/auditlog') WHERE query LIKE '%"after": "1794646799999"%' AND query LIKE '%"before": "1794657600001"%' AND query LIKE '%"spec": "proj/*:env/production:flag/*"%';
----
1

# Every entry over eight pages (seven follow the before cursor), with lookback_days := 0 = all history.
query II
SELECT count(*), count(DISTINCT id) FROM launchdarkly.main.audit_log(lookback_days := 0, page_size := 2);
----
15	15

query I
SELECT count(*) FROM read_json('{LAUNCHDARKLY_FIXTURE_URL}/__requests?path=/api/v2/auditlog') WHERE query LIKE '%"limit": "2"%' AND query LIKE '%"before"%';
----
7

# Without a lower bound only the default 30-day lookback is read (al13 is from 2020).
query T
SELECT list(id ORDER BY id) FROM launchdarkly.main.audit_log() WHERE id IN ('al13', 'al14', 'al15');
----
[al14, al15]

query TTTT
SELECT id, member_name, actions, related_flag_key FROM launchdarkly.main.audit_log(lookback_days := 0) WHERE member_id = 'm2grace000000000000000002' AND resource_kind = 'segment' ORDER BY date;
----
al04	Grace Hopper	[updateIncluded]	dark-mode
al15	Grace Hopper	[updateRules]	NULL

query I
SELECT count(*) FROM read_json('{LAUNCHDARKLY_FIXTURE_URL}/__requests?path=/api/v2/auditlog') WHERE query LIKE '%"member": "m2grace000000000000000002"%' AND query LIKE '%"spec": "proj/*:env/*:segment/*"%';
----
1

query TTT
SELECT id, actor, service_token FROM launchdarkly.main.audit_log(lookback_days := 0) WHERE token_id = 'tok1';
----
al05	ci-deployer	true

query TTT
SELECT id, delta, current_version FROM launchdarkly.main.audit_log(include_diff := true) WHERE date BETWEEN TIMESTAMPTZ '2026-11-14 10:00:00+00' AND TIMESTAMPTZ '2026-11-14 10:30:00+00';
----
al03	[{"op":"replace","path":"/environments/production/on","value":true}]	{"on":true}

query TT
SELECT id, title FROM launchdarkly.main.audit_log(q := 'checkout', lookback_days := 0) ORDER BY id;
----
al02	Grace Hopper updated the targeting rules of New checkout flow
al06	Grace Hopper turned on New checkout flow

# Account-level and project-level kinds build their own specifiers.
query TT
SELECT id, resource_key FROM launchdarkly.main.audit_log(lookback_days := 0) WHERE resource_kind = 'role';
----
al09	release-manager

query T
SELECT id FROM launchdarkly.main.audit_log(lookback_days := 0) WHERE resource_kind = 'environment' AND project_key = 'default';
----
al07

query I
SELECT count(*) FROM read_json('{LAUNCHDARKLY_FIXTURE_URL}/__requests?path=/api/v2/auditlog') WHERE query LIKE '%"spec": "role/*"%' OR query LIKE '%"spec": "proj/default:env/*"%';
----
2

# An OR is not pushed: every entry is read and the SDK filters.
query T
SELECT id FROM launchdarkly.main.audit_log(lookback_days := 0) WHERE resource_kind = 'project' OR resource_kind = 'member' ORDER BY id;
----
al08
al12
