# ------------------------------------------------------------ release_pipelines

query TTT
SELECT p.key, ph.name, ph.environment_keys FROM launchdarkly.main.release_pipelines(project_key := 'default') p, unnest(p.phases) AS u(ph) ORDER BY p.key, ph.idx;
